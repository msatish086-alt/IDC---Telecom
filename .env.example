# PostgreSQL connection
DATABASE_URL="postgresql://idc@localhost:5432/idc_mvp"
# Long random string used to sign login sessions
SESSION_SECRET="change-me-to-a-long-random-string"
# Secret for the alert-scan cron endpoint (GET /api/cron/scan?key=...)
CRON_SECRET="change-me"
# Where task photos are stored (local disk for MVP; S3 later)
STORAGE_DIR="./storage"
# Optional: WhatsApp / SMS gateway webhook. If empty, messages are logged only.
NOTIFY_WEBHOOK_URL=""
# Approval limit in rupees (requests above this need HOD approval)
APPROVAL_LIMIT="10000"
